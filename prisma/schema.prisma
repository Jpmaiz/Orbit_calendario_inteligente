generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ PRINCIPALES ============

model Usuario {
  id                 String    @id @default(uuid())
  email              String    @unique
  nombre             String
  zonaHoraria        String    @default("America/La_Paz") @map("zona_horaria")
  margenMinimoMin    Int       @default(30) @map("margen_minimo_min")
  nivelNotificacion  String    @default("importante") @map("nivel_notificacion")

  creadoEn       DateTime  @default(now()) @map("creado_en")
  modificadoEn   DateTime  @updatedAt @map("modificado_en")
  eliminadoEn    DateTime? @map("eliminado_en")

  materias        Materia[]
  eventos         EventoFijo[]
  eventosPuntuales  Evento[]
  tareas          Tarea[]
  sugerencias     Sugerencia[]
  recordatorios   Recordatorio[]
  interpretaciones InterpretacionIA[]
  aliasMaterias    AliasMateria[]
  periodos         PeriodoAcademico[]
  senales          SenalAprendizaje[]

  @@map("usuarios")
}

model Materia {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  nombre     String
  color      String   @default("#5A3FA0")
  semestre   String?
  codigo     String?

  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")
  eliminadoEn  DateTime? @map("eliminado_en")

  usuario  Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  eventos  EventoFijo[]
  eventosPuntuales  Evento[]
  tareas   Tarea[]
  alias    AliasMateria[]
  @@unique([usuarioId, codigo])

  @@map("materias")
}

model EventoFijo {
  id               String    @id @default(uuid())
  usuarioId        String    @map("usuario_id")
  materiaId        String?   @map("materia_id")
  titulo           String
  diaSemana        Int       @map("dia_semana")
  horaInicio       String    @map("hora_inicio")
  horaFin          String    @map("hora_fin")
  ubicacion        String?
  origen           String    @default("manual")
  uidExterno       String?   @map("uid_externo")
  vigenteDesde     DateTime? @map("vigente_desde")  // inicio del semestre
  vigenteHasta     DateTime? @map("vigente_hasta")  // fin del semestre

  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")
  eliminadoEn  DateTime? @map("eliminado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materia  Materia? @relation(fields: [materiaId], references: [id])

  @@index([usuarioId, diaSemana])
  @@unique([usuarioId, uidExterno])
  @@map("eventos_fijos")
}

model Tarea {
  id                  String    @id @default(uuid())
  usuarioId           String    @map("usuario_id")
  materiaId           String?   @map("materia_id")
  titulo              String
  descripcion         String?
  tipo                String
  fechaLimite         DateTime  @map("fecha_limite")
  duracionEstMin      Int?      @map("duracion_est_min")
  prioridad           String    @default("media")
  
  estado              String    @default("pendiente")
  completadaEn        DateTime? @map("completada_en")
  origen              String    @default("manual")

  dificultad          Int?
  planIA              Json?     @map("plan_ia")
    horaDefinida        Boolean   @default(true) @map("hora_definida") // false = "hora por definir"

  // Fase 1: estimación (la IA califica con la rúbrica, el sistema calcula; ver src/lib/estimacion/rubrica.ts)
  estimacion          Json?                                          // { horas, dificultad, importancia, origen, razones, lectura }
  horasDelUsuario     Boolean   @default(false) @map("horas_del_usuario") // true = el usuario fijó las horas: no se recalculan
  // "Vence con": entrega que se hace al empezar otro examen o evento; si ese cambia de fecha, esta se mueve
  venceConId          String?   @map("vence_con_id")
  venceConClase       String?   @map("vence_con_clase")              // 'tarea' | 'evento'
  // Fase 3: se cierra sola al pasar la fecha (el usuario puede reabrirla y ya no se vuelve a cerrar)
  cerradaSolaEn       DateTime? @map("cerrada_sola_en")
  horasReales         Float?    @map("horas_reales")                 // si respondió la pregunta semanal


  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")
  eliminadoEn  DateTime? @map("eliminado_en")

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materia      Materia?      @relation(fields: [materiaId], references: [id])
  sugerencias  Sugerencia[]
  senales      SenalAprendizaje[]

  @@index([usuarioId, fechaLimite])
  @@index([usuarioId, estado])
  @@index([venceConId])
  @@map("tareas")
}

// Bloques de estudio del plan (Fase 2). motivo = 'estudio' | 'repaso'; estado = 'aceptada' | 'cumplida' | 'omitida'
model Sugerencia {
  id            String    @id @default(uuid())
  usuarioId     String    @map("usuario_id")
  tareaId       String    @map("tarea_id")
  fechaInicio   DateTime  @map("fecha_inicio")
  fechaFin      DateTime  @map("fecha_fin")
  motivo        String
  estado        String    @default("propuesta")
  respondidaEn  DateTime? @map("respondida_en")

  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarea    Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fechaInicio])
  @@index([tareaId])
  @@map("sugerencias")
}

model Recordatorio {
  id            String    @id @default(uuid())
  usuarioId     String    @map("usuario_id")
  tareaId       String?   @map("tarea_id")
  eventoId      String?   @map("evento_id")
  sugerenciaId  String?   @map("sugerencia_id")
  fechaEnvio    DateTime  @map("fecha_envio")
  mensaje       String
  estado        String    @default("pendiente")

  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fechaEnvio])
  @@map("recordatorios")
}

// ============ IA / TRAZABILIDAD ============

model InterpretacionIA {
  id                String    @id @default(uuid())
  usuarioId         String    @map("usuario_id")
  tipoEntrada       String    @map("tipo_entrada")
  entradaOriginal   String    @map("entrada_original")
  respuestaIa       Json      @map("respuesta_ia")
  confianza         Float?
  fueCorregida      Boolean   @default(false) @map("fue_corregida")
  estado            String    @default("pendiente")
  modeloUsado       String    @map("modelo_usado")
  tiempoRespuestaMs Int?      @map("tiempo_respuesta_ms")
  resultado         Json?

  creadoEn  DateTime  @default(now()) @map("creado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, creadoEn])
  @@map("interpretaciones_ia")
}

model AliasMateria {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  materiaId  String   @map("materia_id")
  alias      String
  creadoEn   DateTime @default(now()) @map("creado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materia  Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, alias])
  @@map("alias_materias")
}

model Evento {
  id          String    @id @default(uuid())
  usuarioId   String    @map("usuario_id")
  materiaId   String?   @map("materia_id")
  titulo      String
  descripcion String?
  inicio      DateTime
  fin         DateTime?
  ubicacion   String?
  origen      String    @default("manual")   // manual | texto | foto | google
  uidExterno  String?   @map("uid_externo")  // UID del .ics, para no duplicar al reimportar

  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")
  eliminadoEn  DateTime? @map("eliminado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materia  Materia? @relation(fields: [materiaId], references: [id])

  @@unique([usuarioId, uidExterno])
  @@index([usuarioId, inicio])
  @@map("eventos")
}

model PeriodoAcademico {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  nombre     String                        // "II/2026"
  inicio     DateTime                      // primer día de clases
  fin        DateTime                      // último día de clases

  creadoEn     DateTime  @default(now()) @map("creado_en")
  modificadoEn DateTime  @updatedAt @map("modificado_en")
  eliminadoEn  DateTime? @map("eliminado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fin])
  @@map("periodos_academicos")
}

// Fase 3: lo que Orbit aprende de lo que el usuario ya hace (sin pedirle marcar nada). Ver src/lib/aprendizaje/senales.ts
model SenalAprendizaje {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  tareaId    String?  @map("tarea_id")
  materiaId  String?  @map("materia_id")
  tipoTarea  String?  @map("tipo_tarea")
  clase      String                       // horas | franja | pregunta
  fuente     String                       // plan | edicion | respuesta | mostrada
  razon      Float?                       // horas reales ÷ horas del estudiante promedio
  franja     String?                      // manana | tarde | noche
  voto       Int?                         // +1 / −1
  peso       Float    @default(1)

  creadoEn   DateTime @default(now()) @map("creado_en")

  usuario  Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarea    Tarea?  @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, clase, creadoEn])
  @@map("senales_aprendizaje")
}
